server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

  # Public path for every link handed out. The SPA routes on the hash, so any
  # path under /s/ serves the same index.html.
  location = /s {
    return 301 /s/;
  }

  location = /s/ {
    expires -1;
    try_files /index.html =404;
  }

  location /s/ {
    # Only the exact SPA path exists; anything below it is a mistake, not a
    # route, and must not silently answer with index.html.
    try_files $uri =404;
  }

  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  location /fonts/ {
    expires 1y;
    try_files $uri =404;
  }

  location = /sw.js {
    expires -1;
    try_files $uri =404;
  }

  # The gallery is rendered by the scenes service. This path is only reachable
  # through oauth2-proxy, which is why the service trusts the proxy header.
  # Resolved per request on purpose: a missing gallery upstream must not stop
  # nginx from starting, or share links would go down with it. The resolver
  # comes from the container's /etc/resolv.conf through the image entrypoint.
  location /boards {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $gallery excalidraw-scenes.excalidraw.svc.cluster.local:8080;
    proxy_pass http://$gallery;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The editor lives at the root and under /s/ only. Anything else is a 404 so
  # a stray path never hands out a public editor.
  location = / {
    expires -1;
    try_files /index.html =404;
  }

  location / {
    try_files $uri =404;
  }
}
