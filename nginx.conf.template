server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

  # Public path for every link handed out. The SPA routes on the hash, so any
  # path under /s/ serves the same index.html.
  location = /s {
    return 301 /s/;
  }

  location = /s/ {
    expires -1;
    try_files /index.html =404;
  }

  location /s/ {
    # Only the exact SPA path exists; anything below it is a mistake, not a
    # route, and must not silently answer with index.html.
    try_files $uri =404;
  }

  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # Icon libraries: ~12 MiB of base64 svg, merged into the browser library on
  # first load and only refetched when the manifest version changes.
  location /libraries/ {
    gzip on;
    gzip_types application/json;
    gzip_min_length 1024;
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  location /fonts/ {
    expires 1y;
    try_files $uri =404;
  }

  location = /sw.js {
    expires -1;
    try_files $uri =404;
  }

  # Boards API. Resolved per request on purpose: a missing gallery upstream
  # must not stop nginx from starting, or share links would go down with it.
  # The resolver comes from the container's /etc/resolv.conf.
  location /api/boards {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $gallery excalidraw-scenes.excalidraw.svc.cluster.local:8080;
    proxy_pass http://$gallery;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # A board opened in the editor. Same SPA, private path.
  location /b/ {
    expires -1;
    try_files /index.html =404;
  }

  # The old server-rendered gallery lives on as the editor entry point.
  location = /boards {
    return 302 /;
  }

  # The editor lives at the root and under /s/ only. Anything else is a 404 so
  # a stray path never hands out a public editor.
  location = / {
    expires -1;
    try_files /index.html =404;
  }

  location / {
    try_files $uri =404;
  }
}
