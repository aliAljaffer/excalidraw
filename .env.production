MODE="production"

# Points at the self-hosted deployment; see SELF_HOSTING.md
VITE_APP_BACKEND_V2_GET_URL=https://excalidraw.alialjaffer.com/api/v2/scenes/
VITE_APP_BACKEND_V2_POST_URL=https://excalidraw.alialjaffer.com/api/v2/scenes

# Room persistence for live collaboration: one encrypted scene per room.
VITE_APP_ROOMS_URL=https://excalidraw.alialjaffer.com/api/v2/rooms/

# Private boards: the gallery and its scenes, behind the login only.
VITE_APP_BOARDS_URL=https://excalidraw.alialjaffer.com/api/boards

# Every link handed to someone else resolves under this public path, because
# the private root sits behind a login.
VITE_APP_SHARE_BASE=/s/

# socket server URL used for collaboration
VITE_APP_WS_SERVER_URL=https://excalidraw.alialjaffer.com

# no Firebase project: share-link images are served by our own backend
VITE_APP_FIREBASE_CONFIG='{}'

VITE_APP_ENABLE_TRACKING=false

# Set the below flags explicitly to false in production mode since vite loads and merges .env.local vars when  running the build command
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
# Enable eslint in dev server
VITE_APP_ENABLE_ESLINT=false
